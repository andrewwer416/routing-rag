DATA_DIR=./data
# Empty means evidence-only mode: no generated answer, no chat model required.
LLM_BASE_URL=
LLM_MODEL=llama3.2:3b
LLM_API_KEY=local
# Optional shared token for ALL API endpoints except /health; set for shared deployments.
API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional compose.qwen.yaml local inference model (download via ollama pull).
QWEN_MODEL=qwen2.5:1.5b

# Generic backend: empty uses LLM_MODEL. Local-Qwen overlay: empty defaults to 7B.
ROUTING_MODEL=
ROUTING_TIMEOUT=60

# Bound answer generation, including small-model repetition.
ANSWER_MAX_TOKENS=512

# Local Qwen: keep router and answer model resident to avoid per-request reloads.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m

# Kev-4B decision server (compose.kev.yaml selects these automatically).
ROUTING_PROVIDER=chat
KEV_BASE_URL=http://kev:8009
KEV_API_KEY=local
